---
import Layout from '../layouts/Layout.astro';

const models = [
  { id: 'kimi-k2.7-code', maker: 'Moonshot AI', denom: '1T', note: 'code + agents · 262k context' },
  { id: 'llama-3.3-70b', maker: 'Meta', denom: '70B', note: 'fast fp8 serving' },
  { id: 'gpt-oss-120b', maker: 'OpenAI', denom: '120B', note: 'open-weight reasoning' },
  { id: 'qwen2.5-coder-32b', maker: 'Alibaba', denom: '32B', note: 'tuned for code' },
  { id: 'mistral-small-24b', maker: 'Mistral', denom: '24B', note: 'vision + text' },
  { id: 'llama-3.1-8b', maker: 'Meta', denom: '8B', note: 'quick and cheap' },
];

const steps = [
  {
    n: '01',
    name: 'Discover',
    body: 'The app fetches /.well-known/tpx from whichever provider the user names. One JSON document lists the authorize, token, and API endpoints.',
  },
  {
    n: '02',
    name: 'Authorize',
    body: 'The app redirects to the provider. The user signs in with a passkey and approves the requested token budget on the consent page.',
  },
  {
    n: '03',
    name: 'Grant',
    body: 'The app exchanges a one-time code for a tpx_ access token, scoped to that budget, tied to that app, revocable any time.',
  },
  {
    n: '04',
    name: 'Deliver',
    body: 'The app calls the provider’s OpenAI-compatible API with the grant. The provider meters actual usage against the budget. When it’s spent, the app asks again.',
  },
];
---

<Layout
  title="tokenpony: bring your own tokens to any LLM app"
  description="tokenpony is an LLM proxy for Cloudflare's open-weight models and the first provider to speak TPX, an OAuth-style protocol where apps ship without API keys and users bring their own token budget."
>
  <main>
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="eyebrow">TPX v0.1 · proof of concept</p>
        <h1>Bring your own tokens to any LLM&nbsp;app.</h1>
        <p class="lede">
          tokenpony is an LLM proxy for Cloudflare’s open-weight models, and the first provider
          to speak <strong>TPX</strong>, an OAuth-style protocol where apps ship without API keys
          and you pay a token provider you choose. The app gets a metered budget. You keep the
          reins.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="https://ponychat.tokenpony.dev">Try Pony Chat</a>
          <a class="btn btn-ghost" href="/spec">Read the spec</a>
        </div>
      </div>
      <figure class="envelope" aria-label="TPX discovery request, styled as an airmail envelope">
        <div class="postmark" aria-hidden="true">
          <svg viewBox="0 0 120 120" width="110" height="110">
            <defs>
              <path id="ring" d="M 60,60 m -44,0 a 44,44 0 1,1 88,0 a 44,44 0 1,1 -88,0" />
            </defs>
            <circle cx="60" cy="60" r="54" fill="none" stroke="currentColor" stroke-width="2" />
            <circle cx="60" cy="60" r="32" fill="none" stroke="currentColor" stroke-width="1.5" />
            <text font-size="10.5" letter-spacing="2.5" fill="currentColor" font-family="IBM Plex Mono, monospace">
              <textPath href="#ring">TOKENPONY · TPX/0.1 · USER-PAID ·</textPath>
            </text>
            <text x="60" y="57" text-anchor="middle" font-size="9" fill="currentColor" font-family="IBM Plex Mono, monospace">EST.</text>
            <text x="60" y="69" text-anchor="middle" font-size="9" fill="currentColor" font-family="IBM Plex Mono, monospace">2026</text>
          </svg>
        </div>
        <pre><code><span class="c"># any TPX provider, one request</span>
$ curl https://api.tokenpony.dev/.well-known/tpx

&#123;
  "tpx_version": "0.1",
  "issuer": "https://api.tokenpony.dev",
  "authorization_endpoint": "…/tpx/authorize",
  "token_endpoint": "…/tpx/token",
  "api_base": "…/v1"
&#125;</code></pre>
      </figure>
    </section>

    <section class="why">
      <div class="wrap">
        <h2>Apps shouldn’t have to sell you tokens.</h2>
        <div class="why-grid">
          <article>
            <h3>Today, every app buys tokens</h3>
            <p>
              Every LLM app fronts its own inference bill, so every app fights abuse, throttles
              free tiers, and gates features behind yet another subscription. A thousand apps, a
              thousand billing relationships.
            </p>
          </article>
          <article>
            <h3>With TPX, you bring a budget</h3>
            <p>
              You hold one balance with a provider you trust. An app asks for a scoped grant
              (say, 100k tokens) and you approve it with a passkey. The app never sees your keys
              or your card.
            </p>
          </article>
          <article>
            <h3>The result is an open ecosystem</h3>
            <p>
              Developers ship LLM apps the way they ship static sites: no inference bill, no
              abuse surface, no billing ops. Providers compete on price and models, the way hosts
              compete on email or DNS.
            </p>
          </article>
        </div>
        <p class="plain-talk">
          Prefer plain talk? <a href="/eli5">The campfire version</a> explains all of this
          with hay.
        </p>
      </div>
    </section>

    <section id="how" class="wrap route">
      <p class="eyebrow">The route</p>
      <h2>OAuth taught apps to ask for identity.<br />TPX teaches them to ask for tokens.</h2>
      <ol class="waybill">
        {
          steps.map((s) => (
            <li>
              <span class="step-n" aria-hidden="true">{s.n}</span>
              <div>
                <h3>{s.name}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="models" class="stable">
      <div class="wrap">
        <p class="eyebrow">The stable</p>
        <h2>Open-weight models only.</h2>
        <p class="section-lede">
          Served from Cloudflare Workers AI and metered at Cloudflare's live per-token rates.
          Every model here has published weights; any provider can run them, so no app built
          on TPX is locked to us.
        </p>
        <ul class="stamp-sheet">
          {
            models.map((m) => (
              <li class="stamp">
                <div class="stamp-body">
                  <span class="denom">{m.denom}</span>
                  <span class="stamp-id">{m.id}</span>
                  <span class="stamp-meta">{m.maker} · {m.note}</span>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="compare" class="wrap compare">
      <p class="eyebrow">The field</p>
      <h2>Where TPX is new, and where it isn’t.</h2>
      <p class="section-lede">
        Every piece of this exists somewhere. The OpenAI and Anthropic APIs settled what an
        inference API looks like. OpenRouter proved one API can front many models, and its
        account-connect flow proved users will fund apps from a shared balance. Vendor sign-in
        programs bill approved apps to a subscription. And OAuth is fifteen years old. TPX’s
        claim is narrower: budget-scoped, pseudonymous grants that <em>any</em> provider can
        issue, behind a discovery document instead of a company.
      </p>
      <div class="table-scroll">
        <table class="tariff">
          <thead>
            <tr>
              <th></th>
              <th>OpenAI / Claude API keys</th>
              <th>ChatGPT / Claude sign‑in<span class="fn">*</span></th>
              <th>OpenRouter OAuth</th>
              <th>“Paste your key” apps</th>
              <th class="tpx-col">TPX</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th>Who pays for inference</th>
              <td>The app developer</td>
              <td>The user’s subscription</td>
              <td>The user’s credit balance</td>
              <td>The user</td>
              <td class="tpx-col">The user’s provider balance</td>
            </tr>
            <tr>
              <th>What the app holds</th>
              <td>A raw vendor key</td>
              <td>A vendor-issued token for your account</td>
              <td>A key scoped to your account</td>
              <td>Your raw key</td>
              <td class="tpx-col">A budget-scoped grant</td>
            </tr>
            <tr>
              <th>Per-app spend cap</th>
              <td>No, the key spends freely</td>
              <td>Subscription rate limits, not a budget</td>
              <td>Optional key limit, set after the fact</td>
              <td>No, the key spends freely</td>
              <td class="tpx-col">Yes, a budget you approve up front</td>
            </tr>
            <tr>
              <th>User revocation</th>
              <td>N/A, the user has nothing</td>
              <td>In vendor account settings</td>
              <td>Revoke the key at OpenRouter</td>
              <td>Rotate the key everywhere</td>
              <td class="tpx-col">One click, one app</td>
            </tr>
            <tr>
              <th>Provider choice</th>
              <td>That vendor</td>
              <td>That vendor</td>
              <td>One aggregator, many models</td>
              <td>Whatever the app hardcoded</td>
              <td class="tpx-col">Any issuer of <code>/.well-known/tpx</code></td>
            </tr>
            <tr>
              <th>What the app learns about you</th>
              <td>Whatever it collects</td>
              <td>Your vendor account identity</td>
              <td>A key tied to your account</td>
              <td>Your key = your account</td>
              <td class="tpx-col">Nothing; grants are pseudonymous</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="muted fn-note">
        * “Sign in with ChatGPT” and Claude’s app sign-in bill usage to your consumer
        subscription, but only for vendor-approved apps, inside one vendor’s walls.
      </p>
      <div class="claims">
        <article>
          <h3>Genuinely new here</h3>
          <p>
            Not the connect-an-account gesture: OpenRouter’s OAuth flow and the vendor sign-in
            programs got there first. What TPX adds is the shape of the grant and who can issue
            it. The budget is approved <strong>up front on the consent screen</strong> as a hard
            damage cap, the grant carries <strong>no identity</strong>, and the issuer is <strong>anyone with a discovery document</strong> rather than one company. Apps
            hardcode the protocol, not the vendor.
          </p>
        </article>
        <article>
          <h3>Deliberately borrowed</h3>
          <p>
            The API surface is OpenAI’s, on purpose: your SDK already works. The consent
            choreography is OAuth’s, on purpose: every developer already knows it. And
            user-funded apps are proven ground: OpenRouter charges connected apps to your credit
            balance, and the vendor sign-ins charge approved apps to your subscription. TPX is
            those ideas with the walls removed.
          </p>
        </article>
      </div>
    </section>

    <section id="developers" class="wrap devs">
      <p class="eyebrow">For developers</p>
      <h2>Point your existing SDK at the pony.</h2>
      <p class="section-lede">
        The metered API is OpenAI-compatible. Register your app with one call, send users to
        authorize, and never touch an inference bill again.
      </p>
      <pre class="quickstart"><code><span class="c"># register your app (open registration in the PoC)</span>
$ curl -X POST https://api.tokenpony.dev/tpx/register \
    -d '&#123;"name":"My App","redirect_uris":["https://myapp.example/callback"]&#125;'

<span class="c"># send the user to approve a budget</span>
https://api.tokenpony.dev/tpx/authorize?client_id=…&redirect_uri=…&budget=100000&state=…

<span class="c"># exchange the code, then chat on the user’s tokens</span>
$ curl https://api.tokenpony.dev/v1/chat/completions \
    -H "Authorization: Bearer tpx_…" \
    -d '&#123;"model":"llama-3.3-70b","messages":[&#123;"role":"user","content":"hi"&#125;]&#125;'</code></pre>
    </section>
  </main>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  h1 {
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    margin-block: 0.75rem 1.25rem;
  }

  .lede {
    font-size: 1.15rem;
    max-width: 52ch;
    color: var(--muted);
  }

  .lede strong {
    color: var(--ink);
  }

  .cta-row {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .btn {
    font-family: var(--font-body);
    font-weight: 600;
    text-decoration: none;
    padding: 0.75rem 1.4rem;
    border-radius: 4px;
    font-size: 1rem;
  }

  .btn-primary {
    background: var(--blue);
    color: var(--paper);
    border: 2px solid var(--blue-deep);
    box-shadow: 3px 3px 0 var(--blue-deep);
  }

  .btn-primary:hover {
    translate: 1px 1px;
    box-shadow: 2px 2px 0 var(--blue-deep);
  }

  .btn-ghost {
    color: var(--ink);
    border: 2px solid var(--ink);
  }

  .btn-ghost:hover {
    background: var(--panel);
  }


  /* The envelope */
  .envelope {
    position: relative;
    background: var(--card);
    border: 10px solid transparent;
    border-image: repeating-linear-gradient(
        -45deg,
        var(--red) 0 12px,
        var(--card) 12px 20px,
        var(--blue) 20px 32px,
        var(--card) 32px 40px
      )
      10;
    box-shadow: 0 12px 30px rgb(29 34 51 / 0.12);
    padding: 1.5rem 1.25rem 1.25rem;
    rotate: 1.2deg;
    margin: 0;
  }

  .envelope pre {
    overflow-x: auto;
    font-size: 0.82rem;
    line-height: 1.55;
    padding-top: 0.5rem;
  }

  .postmark {
    position: absolute;
    top: -3.4rem;
    right: -2rem;
    color: var(--red);
    opacity: 0.85;
    rotate: -12deg;
    animation: stamp-in 0.45s cubic-bezier(0.2, 1.4, 0.4, 1) 0.3s backwards;
  }

  @keyframes stamp-in {
    from {
      scale: 1.8;
      opacity: 0;
    }
    to {
      scale: 1;
      opacity: 0.85;
    }
  }

  .c {
    color: var(--muted);
  }

  /* Why */
  .why {
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .why h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    max-width: 24ch;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: 2.5rem;
  }

  .why-grid h3 {
    font-size: 1.2rem;
    margin-bottom: 0.6rem;
    color: #f0c9c2;
  }

  .why-grid p {
    color: #c3c7d4;
    font-size: 0.98rem;
  }

  .plain-talk {
    margin-top: 2rem;
    font-size: 0.92rem;
    color: #8a90a6;
  }

  .plain-talk a {
    color: #f0c9c2;
  }

  /* Waybill */
  .route {
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .route h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    margin-top: 0.5rem;
  }

  .waybill {
    list-style: none;
    padding: 0;
    margin-top: 2.5rem;
    border-top: 2px solid var(--ink);
  }

  .waybill li {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 1.75rem;
    border-bottom: 1px dashed var(--rule);
  }

  .step-n {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    color: var(--red);
  }

  .waybill h3 {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
  }

  .waybill p {
    max-width: var(--measure);
    color: var(--muted);
  }

  /* Stamp sheet */
  .stable {
    background: var(--panel);
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .stable h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    margin-top: 0.5rem;
  }

  .section-lede {
    max-width: 60ch;
    color: var(--muted);
    margin-top: 0.75rem;
  }

  .stamp-sheet {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .stamp {
    background-color: var(--card);
    background-image: radial-gradient(var(--panel) 5px, transparent 5.5px);
    background-size: 16px 16px;
    background-position: -8px -8px;
    padding: 9px;
  }

  .stamp-body {
    position: relative;
    background: var(--card);
    border: 1.5px solid var(--blue);
    outline: 1px solid var(--blue);
    outline-offset: -5px;
    padding: 1rem 0.9rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-height: 8.5rem;
  }

  .denom {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.9rem;
    color: var(--blue);
    line-height: 1;
  }

  .stamp-id {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    margin-top: auto;
  }

  .stamp-meta {
    font-size: 0.78rem;
    color: var(--muted);
  }

  /* Comparison */
  .compare {
    padding-block: clamp(3rem, 7vw, 5rem) 0;
  }

  .compare h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    margin-top: 0.5rem;
  }

  .table-scroll {
    overflow-x: auto;
    margin-top: 2rem;
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    background: var(--card);
  }

  .tariff {
    border-collapse: collapse;
    width: 100%;
    min-width: 58rem;
    font-size: 0.9rem;
  }

  .tariff th,
  .tariff td {
    text-align: left;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }

  .tariff thead th {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-bottom: 2px solid var(--ink);
  }

  .tariff tbody th {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--muted);
    max-width: 11rem;
  }

  .tariff tbody tr:last-child th,
  .tariff tbody tr:last-child td {
    border-bottom: none;
  }

  .tpx-col {
    background: #eef1fa;
    border-left: 2px solid var(--blue);
    font-weight: 500;
  }

  .fn {
    color: var(--red);
  }

  .fn-note {
    font-size: 0.82rem;
    margin-top: 0.6rem;
  }

  .claims {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: 2rem;
  }

  .claims h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
    color: var(--red);
  }

  .claims p {
    color: var(--muted);
    font-size: 0.97rem;
  }

  /* Developers */
  .devs {
    padding-block: clamp(3rem, 7vw, 5rem) 0;
  }

  .devs h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    margin-top: 0.5rem;
  }

  .quickstart {
    margin-top: 2rem;
    background: var(--ink);
    color: #e8e5da;
    padding: 1.5rem;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.7;
  }

  .quickstart .c {
    color: #8a90a6;
  }

  @media (max-width: 56rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }

    .envelope {
      rotate: 0deg;
      margin-top: 1rem;
    }

    .postmark {
      top: -1.8rem;
      right: 0.2rem;
    }

    .why-grid,
    .claims {
      grid-template-columns: minmax(0, 1fr);
    }

    .waybill li {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>
