</Layout>

<style>
  .nf {
    padding-block: clamp(4rem, 12vw, 8rem);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-block: 0.75rem 1rem;
  }
</style>
